{%- if api -%}
import os

import httpx2
import uvicorn

from {{ package_name }}.api import create_app


def main() -> None:
    upstream = httpx2.AsyncClient(
        base_url=os.environ.get("UPSTREAM_URL", "http://localhost:8001"),
        timeout=5.0,
    )
    uvicorn.run(
        create_app(upstream),
        # Containers are only reachable from outside when bound to all interfaces.
        host="0.0.0.0",  # noqa: S104
        port=int(os.environ.get("PORT", "8000")),
    )
{%- else -%}
import argparse

from {{ package_name }}.core import greet


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(description="{{ description or project_name }}")
    parser.add_argument("name", nargs="?", default="world")
    args = parser.parse_args(argv)
    print(greet(args.name))
{%- endif %}


if __name__ == "__main__":
    main()
