import pytest

from {{ package_name }}.core import greet


@pytest.mark.parametrize(
    ("name", "expected"),
    [("Ada", "Hello, Ada!"), ("  Ada  ", "Hello, Ada!"), ("", "Hello, world!")],
)
def test_greet(name: str, expected: str) -> None:
    assert greet(name) == expected
